{
  "manifest_version": 3,
  "name": "Clean Telegram Web",
  "version": "1.2.1",
  "description": "Removes unwanted text, emojis, reactions, and comments from Telegram Web.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "icons": {
    "16": "icons/cleantelegram.png",
    "32": "icons/cleantelegram.png",
    "48": "icons/cleantelegram.png",
    "128": "icons/cleantelegram.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cleantelegram.png",
      "32": "icons/cleantelegram.png",
      "48": "icons/cleantelegram.png",
      "128": "icons/cleantelegram.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}